# Tello Web Controller - Environment Configuration
# Copy this file to .env and adjust values as needed

# Drone connection
TELLO_TELLO_HOST=192.168.10.1
TELLO_USE_MOCK_DRONE=true
# Mock mode only: seconds each fake command takes, so you can watch sequences play
TELLO_MOCK_COMMAND_DELAY_S=0.8

# Backend server
TELLO_API_PORT=8000

# Frontend
TELLO_FRONTEND_PORT=3000

# Telemetry
TELLO_TELEMETRY_POLL_HZ=4.0

# Video streaming
TELLO_VIDEO_FPS=30
TELLO_VIDEO_JPEG_QUALITY=70

# CORS (JSON array of allowed origins)
TELLO_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Flight sequencer safety limits (battery %)
TELLO_SEQUENCE_MIN_BATTERY_PCT=30
TELLO_SEQUENCE_FLIP_MIN_BATTERY_PCT=50
TELLO_SEQUENCE_ABORT_BATTERY_PCT=15

# On-screen warnings (battery %, Wi-Fi signal-to-noise; tune the signal ones to your space)
TELLO_BATTERY_LOW_PCT=30
TELLO_BATTERY_CRITICAL_PCT=15
TELLO_WIFI_SNR_WEAK=40
TELLO_WIFI_SNR_CRITICAL=20

# Stick flying (game controller / hold-to-fly keys)
TELLO_RC_SPEED_LIMIT_PCT=100
TELLO_RC_TIMEOUT_S=0.5

# Camera: photos and clips (saved in ./data/media when using Docker)
TELLO_RECORD_FPS=30
TELLO_RECORD_MAX_S=300
# If orbit or glide steps drift the wrong way sideways on your drone, set this to false
TELLO_GO_Y_IS_LEFT=true

# Mock mode only: try the warnings without a drone, e.g. 20 and 30
# TELLO_MOCK_BATTERY_PCT=85
# TELLO_MOCK_WIFI_SNR=90

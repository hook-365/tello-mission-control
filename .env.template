# Tello Web Controller - Environment Configuration
# Copy this file to .env and adjust values as needed

# Drone connection
TELLO_TELLO_HOST=192.168.10.1
TELLO_USE_MOCK_DRONE=true

# Backend server
TELLO_API_PORT=8000

# Frontend
TELLO_FRONTEND_PORT=3000

# Continuous (stick) control: hover if input is not refreshed within this window
TELLO_RC_TIMEOUT_MS=500

# Flight log: records telemetry + commands per connection to SQLite
TELLO_FLIGHT_LOG_ENABLED=true
TELLO_FLIGHT_LOG_PATH=data/flights.db

# Telemetry
TELLO_TELEMETRY_POLL_HZ=4.0

# Vision (optional): object detection overlay + person tracking.
# Needs backend/requirements-vision.txt, or docker-compose.vision.yml with Docker.
TELLO_VISION_ENABLED=false
# TELLO_VISION_MODEL=yolov8n.pt
# TELLO_VISION_DEVICE=            # empty = auto, or cpu / cuda:0
# TELLO_VISION_HZ=5.0
# TELLO_VISION_TRACK_MAX_SPEED=30

# Video streaming
TELLO_VIDEO_FPS=30
TELLO_VIDEO_JPEG_QUALITY=70

# CORS (JSON array of allowed origins)
TELLO_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
